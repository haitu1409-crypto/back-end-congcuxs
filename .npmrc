# Tối ưu Puppeteer cho Render deployment
puppeteer_skip_chromium_download=true

# Sử dụng npm registry chính thức
registry=https://registry.npmjs.org/

# Tối ưu npm install
fund=false
audit=false
progress=false
loglevel=error

# Cache settings
cache-max=86400000
cache-min=3600000

# Timeout settings
timeout=300000
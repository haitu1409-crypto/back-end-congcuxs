# Telegram Auto Schedule Configuration
# Thời gian tự động gửi kết quả XSMB (chỉ 1 mốc thời gian duy nhất)
# Format: "18:35" - chỉ schedule 1 cron job tại thời gian này
TELEGRAM_AUTO_SCHEDULE_TIME_XSMB=18:35

# Telegram Live Window Configuration (cho socket realtime)
# Khung giờ bot sẽ kết nối socket để nhận kết quả realtime (giống frontend)
# Mặc định: 18:10 - 18:33
TELEGRAM_LIVE_WINDOW_HOUR=18
TELEGRAM_LIVE_WINDOW_START_MINUTE=10
TELEGRAM_LIVE_WINDOW_END_MINUTE=33

# XSMB Scraper Scheduler Configuration
# Thời gian chạy scraper tự động (mặc định: 18:14 - theo dự án cũ)
# 18:10 - LiveResult xuất hiện với bảng rỗng
# 18:14 - Scraper khởi động và cào kết quả
# 18:33 - Kết thúc live window (hoặc khi kết quả đầy đủ)
XSMB_SCRAPER_HOUR=18
XSMB_SCRAPER_MINUTE=14
XSMB_SCRAPER_TIMEZONE=Asia/Ho_Chi_Minh

# XSMN Scraper Scheduler Configuration
XSMN_SCRAPER_HOUR=16
XSMN_SCRAPER_MINUTE=14
XSMN_SCRAPER_TIMEZONE=Asia/Ho_Chi_Minh
XSMB_SCRAPER_TIMEZONE=Asia/Ho_Chi_Minh

# Stats Scheduler Configuration
# Thời gian tự động cập nhật các loại thống kê (giờ Việt Nam)
TIME_UPDATE_THONGKEDAUDUOI=18:38
TIME_UPDATE_THONGKELOGAN=18:39
TIME_UPDATE_GIAIDACBIET=18:40
TIME_UPDATE_GIAIDACBIETTUAN=18:42
TIME_UPDATE_TANSUATLOTO=18:44
TIME_UPDATE_TANSUATLOCAP=18:46